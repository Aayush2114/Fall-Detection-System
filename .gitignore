# ==============================================================================
# Git Ignore for Fall Detection System
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints/

# Data files (too large for git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Trained models (too large for git)
models/*.pth
models/*.pkl
!models/.gitkeep

# Output files
outputs/*
!outputs/.gitkeep

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
